{
  "permissions": {
    "allow": [
      "Bash(git push origin HEAD:main)",
      "Bash(git push origin HEAD:main *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/sync-main.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push origin HEAD:main*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/sync-main.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
